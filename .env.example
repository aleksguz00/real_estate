# Скопируйте в .env и заполните своими значениями.

# Telegram-бот
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# База данных
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate
DB_USER=dbuser
DB_PASSWORD=dbpassword

# Telethon (my.telegram.org) — парсер каналов
API_ID=1234567
API_HASH=00000000000000000000000000000000

# Геокодеры
YANDEX_GEOCODER_KEY=00000000-0000-0000-0000-000000000000
GIS_API_KEY=00000000-0000-0000-0000-000000000000

# ID каналов-источников (со знаком минус)
CHANNEL_RENT=-1000000000000
CHANNEL_SALE=-1000000000000

# Перевалочный чат для получения file_id фотографий
STORAGE_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
STORAGE_CHAT_ID=000000000

# Проверка «бот уже запущен» (pgrep). 1 — включить (локальная разработка),
# пусто/0 — выключить. На сервере под systemd должна быть ВЫКЛЮЧЕНА.
SINGLE_INSTANCE_CHECK=0
